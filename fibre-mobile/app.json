{
  "expo": {
    "name": "Fiber360",
    "slug": "fibre360-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fibre360",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fibre360.mobile",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0D5CFF"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Fiber360 needs camera access to capture field photos.",
        "NSLocationWhenInUseUsageDescription": "Fiber360 needs your location to show your position on the survey map.",
        "NSPhotoLibraryUsageDescription": "Fiber360 needs photo library access to save captured photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D5CFF"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0D5CFF"
      },
      "package": "com.fibre360.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker",
      "expo-location",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "def2727e-a8f0-477d-af08-01b7ea44a3b3"
      }
    },
    "owner": "sanskriti17"
  }
}
